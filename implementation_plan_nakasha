class ConfidenceScorer:
    """Stage 6: Produce confidence score and route decision."""
    
    # Weight allocation per Advante feasibility analysis
    BOUNDARY_QUALITY_WEIGHT = 0.30
    RECORD_MATCH_WEIGHT = 0.35
    GNSS_ALIGNMENT_WEIGHT = 0.25
    DATUM_ACCURACY_WEIGHT = 0.10
    
