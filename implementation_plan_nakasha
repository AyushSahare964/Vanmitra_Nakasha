            + gnss_alignment * self.GNSS_ALIGNMENT_WEIGHT
            + datum_accuracy * self.DATUM_ACCURACY_WEIGHT
        )
        if confidence >= self.AUTO_PUBLISH_THRESHOLD:
            route = "auto_publish"
