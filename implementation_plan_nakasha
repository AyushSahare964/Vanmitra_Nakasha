// ── Module C: Bhumi-Nakasha Cadastral Intelligence ───────────────────────────

/**
 * Analyze a cadastral document / survey number via Bhumi-Nakasha pipeline.
 * @param {Object} params
 * @param {string} params.villageId       - Village ID (e.g. "ozar")
 * @param {string} params.surveyNumber    - Survey number (e.g. "255")
 * @param {number} [params.nSubdivisions] - Expected sub-parcel count (default 1)
 * @param {number} [params.centroidLat]   - Fallback centroid lat
 * @param {number} [params.centroidLng]   - Fallback centroid lng
 * @param {File}   [params.cadastralFile] - Scanned cadastral image file
 * @param {string} [params.revenueText]   - 7/12 / Khata OCR text
 * @param {string} [params.nlQuery]       - Natural language query
 * @returns {Promise<Object>} Bhumi-Nakasha result
 */
async function analyzeCadastral({
  villageId, surveyNumber, nSubdivisions = 1,
  centroidLat, centroidLng,
  cadastralFile, revenueText, nlQuery,
}) {
  const fd = new FormData();
  fd.append('village_id',     villageId);
  fd.append('survey_number',  surveyNumber);
  fd.append('n_subdivisions', nSubdivisions);
  if (centroidLat)    fd.append('centroid_lat',          centroidLat);
  if (centroidLng)    fd.append('centroid_lng',          centroidLng);
  if (cadastralFile)  fd.append('cadastral_image',       cadastralFile);
  if (revenueText)    fd.append('revenue_record_text',   revenueText);
  if (nlQuery)        fd.append('nl_query',              nlQuery);

  const res = await fetch(`${API_BASE}/api/v1/bhumi-naksha/analyze`, {
    method: 'POST', body: fd,
  });
  if (!res.ok) throw new Error(`Bhumi-Nakasha API error: ${res.status}`);
  return res.json();
}

